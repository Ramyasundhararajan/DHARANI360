# ---------------------------------------------------------------------------
# DHARANI 360 - settings for THIS installation
# ---------------------------------------------------------------------------
# Copy this file to ".env" and fill in the values. The .env file is listed in
# .gitignore and must never be committed or emailed.
#
#   copy .env.example .env        (Windows)
#   cp   .env.example .env        (Mac / Linux)
#
# Check what the app is actually reading at any time:
#
#   python config.py
#
# Every setting below is optional. With an empty .env, DHARANI 360 runs
# exactly as it always has: SQLite, on this computer, no hosting.
# ---------------------------------------------------------------------------


# --- Database --------------------------------------------------------------
# Leave empty to keep using the local file at instance/dharani360.db.
# Set it to switch the whole system onto PostgreSQL - nothing else changes.
#
# From Supabase: Project Settings -> Database -> Connection string ->
# "Transaction pooler" (port 6543). Replace [YOUR-PASSWORD] with the database
# password you chose when the project was created.
#
# DATABASE_URL=postgresql://postgres.xxxxxxxx:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
DATABASE_URL=


# --- Session security ------------------------------------------------------
# Signs the login cookie. REQUIRED once hosted: without it a new key is made
# on every restart and everybody is signed out.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Marks the login cookie "Secure" so it is only ever sent over HTTPS.
# Leave empty to decide automatically: on when hosted, off on a local PC.
SECURE_COOKIES=

# How many hours a sign-in lasts before it must be renewed.
SESSION_HOURS=12


# --- Supabase (sign-in, and attachment storage) ----------------------------
# Project Settings -> API. Use the publishable / anon key.
# NEVER put the service_role key here - it bypasses every security rule.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Bucket that holds record attachments once storage is switched on.
SUPABASE_BUCKET=dharani360-files

# Who may sign in, comma separated. Leave empty to use the list built into
# supabase_auth.py.
# ALLOWED_EMAILS=ramya@dharanis.ae,akbar@dharanis.ae
ALLOWED_EMAILS=


# --- Web server ------------------------------------------------------------
PORT=5000

# Number of worker processes. MUST stay at 1 on SQLite - several processes
# writing one file will corrupt it. On Postgres, 2-4 is sensible.
GUNICORN_WORKERS=1


# --- File storage (attachments) --------------------------------------------
# Leave empty and scanned passports, licences and contracts stay in
# instance/uploads/ on this machine - fine for one PC, wrong for a server,
# because a server's disk is disposable and these files are the evidence
# behind every register.
#
# Set all four and they move to object storage. Works with Supabase Storage,
# Cloudflare R2, Backblaze B2, Wasabi and AWS S3.
#
#   S3_ENDPOINT=https://<project>.storage.supabase.co/storage/v1/s3
# Then move what is already on disk:
#   python migrate_files.py check
#   python migrate_files.py upload
#   python migrate_files.py verify
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=ap-south-1


# --- Backups ---------------------------------------------------------------
BACKUP_DIR=
KEEP_DAYS=30

# A second place every backup is copied to. A backup on the same disk as the
# database is lost with it, so point this at another drive, a network share,
# or a synced folder.
#   COPY_TO=C:\Users\ramya\OneDrive\Dharani360 Backups
COPY_TO=


# --- Daily compliance digest (optional) ------------------------------------
# Gmail, Outlook/365 and Zoho all work with an app password - not the normal
# account password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
DIGEST_FROM=
DIGEST_TO=


# --- Demo deployments only -------------------------------------------------
# 1 = wipe and re-seed sample data on every start. Never set this on an
# installation that holds real records.
DEMO_MODE=0
